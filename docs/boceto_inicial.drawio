        <mxCell id="PzCnvnJzZ4PAQi_K22xr-58" parent="FyA0gOC4x-u_ko7VUgHS-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=9;fontColor=default;" value="Condiciones de uso" vertex="1">
          <mxGeometry height="30" width="117.2" x="3034.1" y="402" as="geometry" />
        </mxCell>
        <mxCell id="PzCnvnJzZ4PAQi_K22xr-59" parent="FyA0gOC4x-u_ko7VUgHS-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=6;fontColor=default;" value="&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); white-space: pre-wrap;&quot;&gt;Karpooling conecta a conductores y pasajeros para compartir trayecto. No somos transportistas ni parte del acuerdo entre usuarios.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); white-space: pre-wrap;&quot;&gt;Debes ser mayor de edad y tener un carné de conducir válido si publicas viajes.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); white-space: pre-wrap;&quot;&gt;Los costes del viaje se reparten entre los usuarios; no está permitido tener ánimo de lucro.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); white-space: pre-wrap;&quot;&gt;Karpooling no se hace responsable de daños o incidentes durante el viaje.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); white-space: pre-wrap;&quot;&gt;Podemos suspender cuentas que incumplan estas condiciones.&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="159" x="3016" y="423" as="geometry" />
        </mxCell>
